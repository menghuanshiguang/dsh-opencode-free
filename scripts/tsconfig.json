{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "../src/gateway.js",
    "../src/egress.js",
    "../src/store.js",
    "./check-extraction.mjs",
    "./tests/*.mjs"
  ]
}
